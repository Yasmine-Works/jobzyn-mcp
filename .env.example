# Copy to .env and replace placeholders. Never commit .env.
# Use: node --env-file=.env dist/cli.js [--transport http]
JOBZYN_API_KEY=jz_replace_with_your_jobzyn_api_key
JOBZYN_BASE_URL=https://www.jobzyn.com/api/integrations
JOBZYN_REQUEST_TIMEOUT_MS=30000
MCP_TRANSPORT=stdio

# HTTP mode only. Generate a separate token: openssl rand -hex 32
MCP_AUTH_TOKEN=replace_with_a_separate_random_token_of_at_least_32_characters
HOST=127.0.0.1
PORT=3000
# Required when HOST is not loopback. Exact hostnames, no schemes or ports.
# MCP_ALLOWED_HOSTS=mcp.example.com,localhost,127.0.0.1
# Browser origins only; omit for server-to-server clients without Origin.
# MCP_ALLOWED_ORIGINS=https://your-client.example.com
